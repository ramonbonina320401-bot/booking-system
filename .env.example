# Firebase (copy this file to .env and fill in real values — never commit .env)
# Find these in Firebase console → Project settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web push certificate (public key) for push notifications — Firebase console →
# Project settings → Cloud Messaging → Web push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
